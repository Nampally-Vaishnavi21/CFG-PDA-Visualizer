  "q0" [shape=circle, fillcolor="#F4F7FB"];
  "q1" [shape=circle, fillcolor="#F4F7FB"];
  "q2" [shape=doublecircle, fillcolor="#F4F7FB"];
  __start -> "q0";
  "q0" -> "q0" [label="0, Z0 → 0 Z0\l1, Z0 → 1 Z0\l0, 0 → 0 0\l1, 0 → 1 0\l0, 1 → 0 1\l1, 1 → 1 1\l"];
  "q0" -> "q1" [label="0, Z0 → Z0\l1, Z0 → Z0\l0, 0 → 0\l1, 0 → 0\l0, 1 → 1\l1, 1 → 1\lε, Z0 → Z0\lε, 0 → 0\lε, 1 → 1\l"];
  "q1" -> "q1" [label="0, 0 → ε\l1, 1 → ε\l"];
  "q1" -> "q2" [label="ε, Z0 → Z0\l"];
}